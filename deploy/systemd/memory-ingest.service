[Unit]
Description=memory-mcp daily ingest + distill
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/memory/deploy
# Optional: config for pull-remote-sessions.sh (host list, path overrides).
# Skips silently if this file doesn't exist — remote pull is opt-in.
EnvironmentFile=-/srv/memory/deploy/pull-remote-sessions.env
# '-' prefix: one bad host/file/step must not skip the rest — pull's own
# output, ingest's ledger, and export/push's own output record any per-host
# or per-file failure for inspection. distill is the one line without '-':
# its exit status is what marks this unit failed.
ExecStart=-/srv/memory/deploy/pull-remote-sessions.sh
ExecStart=-/srv/memory/deploy/export-opencode-sessions.sh
ExecStart=-/usr/bin/docker compose -f compose.prod.yaml exec -T memory-mcp memoryctl ingest
ExecStart=/usr/bin/docker compose -f compose.prod.yaml exec -T memory-mcp memoryctl distill
# Re-export active facts to markdown and push into the Obsidian vault, so
# approved facts show up there without a manual step. Opt-in via
# OBSIDIAN_PUSH_HOST/OBSIDIAN_VAULT_PATH in pull-remote-sessions.env.
ExecStart=-/usr/bin/docker compose -f compose.prod.yaml exec -T memory-mcp memoryctl export-vault --out /srv/memory/export/vault
ExecStart=-/srv/memory/deploy/push-obsidian-vault.sh
