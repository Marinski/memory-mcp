# memory-mcp deployment — copy to .env and fill in.
# All services bind WG-only; nothing here is internet-reachable.

# Postgres (container in this compose)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://memory:${POSTGRES_PASSWORD}@memory-postgres:5432/memory

# Existing services on this host (external, referenced not redeclared)
QDRANT_URL=http://qdrant:6333
AIGATE_BASE_URL=http://aigate-litellm-1:4000/v1
AIGATE_API_KEY=sk-your-litellm-key

# Docker network names for the external Qdrant/gateway containers above —
# see deploy/compose.prod.yaml's `networks:` section. Defaults match the
# hostnames above; override if yours differ (e.g. `docker network ls`).
#QDRANT_NETWORK=qdrant_default
#AIGATE_NETWORK=aigate_default

# Embeddings — pinned; changing dims = new collection + memoryctl reembed.
# EMBED_MODEL is the litellm ROUTE name, not the underlying model id.
EMBED_MODEL=local-embed-bge-m3
EMBED_DIMS=1024

# Distillation LLM — litellm route name
DISTILL_MODEL=vllm-gemma4

# Use a SCOPED litellm virtual key limited to the two routes above —
# never the master key.

# WG interface bind.
# In compose the container listens on 0.0.0.0 and the WG-only property comes
# from the host port binding: LISTEN_HOST must be this host's WG address.
LISTEN=10.8.0.1:7105
LISTEN_HOST=10.8.0.1

# v1 auth: random 32-byte hex bearer (openssl rand -hex 32)
AUTH_MODE=static
STATIC_BEARER=

# Ingestion
INBOX_DIR=/srv/memory/inbox
MAX_RESULT_KB=50

# Optional overrides (defaults shown)
#QDRANT_COLLECTION=memory_archive
# Path to the gitleaks binary; baked into the image at this path.
# Scrubbing is fail-closed — ingest aborts (transient failure, retried)
# when the binary cannot run.
#GITLEAKS_PATH=/usr/local/bin/gitleaks
