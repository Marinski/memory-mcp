# Config for deploy/pull-remote-sessions.sh — copy to pull-remote-sessions.env
# and fill in your own host aliases (from ~/.ssh/config on this machine).

# This host's own device name in the inbox. Leave empty to skip local pull.
LOCAL_DEVICE_NAME=

# Space-separated SSH config aliases for Linux/macOS hosts with rsync.
REMOTE_RSYNC_HOSTS=

# Space-separated SSH config aliases for Windows hosts (SFTP/scp only,
# ssh-* mirror directories are skipped automatically — see the script).
REMOTE_SCP_HOSTS=

# Optional: override the remote Claude-projects path for a specific
# REMOTE_SCP_HOSTS entry when the SSH login account differs from the
# account that owns the sessions. Var name is the host alias, uppercased,
# with '.' and '-' replaced by '_', suffixed _CLAUDE_PATH.
# Example: host alias "my-server" -> MY_SERVER_CLAUDE_PATH
#MY_SERVER_CLAUDE_PATH=/C:/Users/someuser/.claude/projects

# Optional: same override, for deploy/pull-vscode-dbs.sh's remote VS Code
# Chat session-store.db path (suffixed _VSCODE_PATH). Applies to
# REMOTE_SCP_HOSTS only — REMOTE_RSYNC_HOSTS always use
# ~/.vscode-server/data/User/globalStorage/github.copilot-chat/session-store.db.
#MY_SERVER_VSCODE_PATH=/C:/Users/someuser/AppData/Roaming/Code/User/globalStorage/github.copilot-chat/session-store.db

# Optional: override a host's inbox folder name when it should differ from
# the SSH config alias (same uppercase/underscore naming, suffixed
# _DEVICE_NAME). Applies to both REMOTE_RSYNC_HOSTS and REMOTE_SCP_HOSTS.
#MY_SERVER_DEVICE_NAME=my-server-short-name

# Config for deploy/push-obsidian-vault.sh — pushes memoryctl export-vault's
# markdown output into a live Obsidian vault after each ingest+distill run.
# Both required to enable the push; leave empty (default) to skip it.
OBSIDIAN_PUSH_HOST=
# Remote vault root. Windows paths need the /C:/... form (see
# MY_SERVER_CLAUDE_PATH above for why) since scp/sftp don't understand
# backslash paths.
OBSIDIAN_VAULT_PATH=
# Subfolder inside the vault the exported notes are written to.
#OBSIDIAN_VAULT_SUBDIR=Memory

# Config for deploy/export-opencode-sessions.sh — exports this host's local
# OpenCode sessions (~/.local/share/opencode/opencode.db) into
# LOCAL_DEVICE_NAME's inbox folder. Opt-in: no-ops if the db doesn't exist
# or LOCAL_DEVICE_NAME is unset. Only override if OpenCode's data dir isn't
# the default.
#OPENCODE_DB=/home/you/.local/share/opencode/opencode.db

# Config for deploy/export-vscode-sessions.sh — exports this host's local
# VS Code Chat panel sessions into LOCAL_DEVICE_NAME's inbox folder.
# Opt-in: no-ops if the db doesn't exist or LOCAL_DEVICE_NAME is unset.
# Only override if VS Code Server's data dir isn't the default.
#VSCODE_DB=/home/you/.vscode-server/data/User/globalStorage/github.copilot-chat/session-store.db
