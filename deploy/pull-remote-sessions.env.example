# Config for deploy/pull-remote-sessions.sh — copy to pull-remote-sessions.env
# and fill in your own host aliases (from ~/.ssh/config on this machine).

# This host's own device name in the inbox. Leave empty to skip local pull.
LOCAL_DEVICE_NAME=

# Space-separated SSH config aliases for Linux/macOS hosts with rsync.
REMOTE_RSYNC_HOSTS=

# Space-separated SSH config aliases for Windows hosts (SFTP/scp only,
# ssh-* mirror directories are skipped automatically — see the script).
REMOTE_SCP_HOSTS=

# Optional: override the remote Claude-projects path for a specific
# REMOTE_SCP_HOSTS entry when the SSH login account differs from the
# account that owns the sessions. Var name is the host alias, uppercased,
# with '.' and '-' replaced by '_', suffixed _CLAUDE_PATH.
# Example: host alias "my-server" -> MY_SERVER_CLAUDE_PATH
#MY_SERVER_CLAUDE_PATH=/C:/Users/someuser/.claude/projects

# Optional: override a host's inbox folder name when it should differ from
# the SSH config alias (same uppercase/underscore naming, suffixed
# _DEVICE_NAME). Applies to both REMOTE_RSYNC_HOSTS and REMOTE_SCP_HOSTS.
#MY_SERVER_DEVICE_NAME=my-server-short-name
